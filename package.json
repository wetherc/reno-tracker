{
  "name": "reno-tracker",
  "version": "1.6.0",
  "private": true,
  "description": "Home renovation project tracker. Local Node server with SQLite, or a static site that keeps data in the browser. Plain web client.",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/server/index.js",
    "build:pages": "node scripts/build-pages.js dist",
    "serve:pages": "node scripts/serve-pages.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node scripts/check-css-tokens.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=ExperimentalWarning --test 'tests/unit/**/*.test.js' 'tests/server/**/*.test.js'",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage 'tests/unit/**/*.test.js' 'tests/server/**/*.test.js'",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
